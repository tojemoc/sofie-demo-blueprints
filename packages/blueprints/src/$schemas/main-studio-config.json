{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.com/product.schema.json",
	"title": "Studio Config",
	"type": "object",
	"properties": {
		"visionMixer": {
			"type": "object",
			"title": "VisionMixerConfig",
			"description": "Vision mixer device configuration",
			"ui:category": "Vision Mixer Device",
			"ui:title": "Vision Mixer Device Configuration",
			"properties": {
				"deviceId": {
					"type": "string",
					"description": "Vision mixer playout device ID",
					"ui:title": "Vision Mixer Device ID",
					"ui:description": "Vision Mixer Device ID (E.G. visionMixer)",
					"ui:summaryTitle": "Device"
				},
				"type": {
					"type": "string",
					"description": "Vision mixer type",
					"ui:category": "Vision Mixer",
					"ui:title": "Vision Mixer Device",
					"title": "VisionMixerDevice",
					"enum": ["Atem", "Vmix"],
					"tsEnumNames": ["Atem", "VMix"],
					"default": "Atem"
				},
				"host": {
					"type": "string",
					"description": "Host IP of the vision mixer",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of the vision mixer (E.G. 0.0.0.0)",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of the vision mixer",
					"ui:title": "Port",
					"ui:description": "Port of the vision mixer (E.G. 9910)",
					"default": 9910
				}
			},
			"required": ["deviceId", "type", "host", "port"],
			"additionalProperties": false
		},
		"audioMixer": {
			"type": "object",
			"title": "AudioMixerConfig",
			"description": "Audio mixer device configuration",
			"ui:category": "Sisyfos Device",
			"ui:title": "Audio Mixer Device Configuration",
			"properties": {
				"deviceId": {
					"type": "string",
					"description": "Audio mixer playout device ID",
					"ui:title": "Audio Mixer Device ID",
					"ui:description": "Audio Mixer Device ID (E.G. audioMixer)",
					"ui:summaryTitle": "Device"
				},
				"host": {
					"type": "string",
					"description": "Host IP of Sisyfos",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of Sisyfos",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of Sisyfos",
					"ui:title": "Port",
					"ui:description": "Port of Sisyfos (default is 1176)",
					"default": 1176
				}
			},
			"required": ["deviceId", "host", "port"],
			"additionalProperties": false
		},
		"casparcg": {
			"type": "object",
			"title": "CasparCGConfig",
			"description": "CasparCG device configuration",
			"ui:category": "CasparCG Device",
			"ui:title": "CasparCG Device Configuration",
			"properties": {
				"host": {
					"type": "string",
					"description": "Host IP of CasparCG",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of CasparCG",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of CasparCG",
					"ui:title": "Port",
					"ui:description": "Port of CasparCG (default is 5250)",
					"default": 5250
				}
			},
			"required": ["host", "port"],
			"additionalProperties": false
		},
		"atemSources": {
			"type": "object",
			"ui:title": "Atem Sources",
			"ui:description": "Description of Atem inputs i.e. cameras, remotes etc.",
			"ui:category": "Inputs",
			"additionalProperties": {
				"type": "object",
				"title": "InputConfig",
				"properties": {
					"input": {
						"type": "integer",
						"ui:title": "Input",
						"ui:description": "Input number on the atem, see https://atem.julusian.dev/enums#videosource",
						"ui:summaryTitle": "Input",
						"default": 1
					},
					"type": {
						"$ref": "#/$defs/SourceType"
					}
				},
				"required": ["input", "type"]
			}
		},
		"atemOutputs": {
			"type": "object",
			"ui:title": "Atem Outputs",
			"ui:description": "Description of Atem outputs / auxes",
			"ui:category": "Outputs",
			"additionalProperties": {
				"type": "object",
				"title": "OutputConfig",
				"properties": {
					"output": {
						"type": "integer",
						"ui:title": "Output",
						"ui:description": "Aux number on the atem",
						"ui:summaryTitle": "Output",
						"default": 1
					},
					"source": {
						"type": "integer",
						"ui:title": "Source",
						"ui:description": "Source number, see https://atem.julusian.dev/enums#videosource",
						"ui:summaryTitle": "Source",
						"default": 1
					}
				},
				"required": ["output", "source"]
			}
		},
		"vmixSources": {
			"type": "object",
			"ui:title": "vMix Sources",
			"ui:description": "Description of vMix inputs i.e. cameras, remotes etc.",
			"ui:category": "Inputs",
			"additionalProperties": {
				"type": "object",
				"title": "VmixInputConfig",
				"properties": {
					"input": {
						"type": "integer",
						"ui:title": "Input",
						"ui:description": "Input number for the vmix source",
						"ui:summaryTitle": "Input",
						"default": 1
					},
					"type": {
						"$ref": "#/$defs/SourceType"
					},
					"label": {
						"type": "string",
						"ui:title": "Label",
						"ui:description": "Human-readable name matching the vMix input title (used in adLib shelves)",
						"ui:summaryTitle": "Label"
					},
					"category": {
						"$ref": "#/$defs/VmixSourceCategory"
					},
					"overlayChannel": {
						"type": "integer",
						"minimum": 1,
						"maximum": 4,
						"ui:title": "Overlay Channel",
						"ui:description": "Default vMix overlay channel (1-4) when this source is used as a graphic overlay",
						"ui:summaryTitle": "Overlay"
					},
					"defaultVolume": {
						"type": "integer",
						"minimum": 0,
						"maximum": 100,
						"ui:title": "Default Volume",
						"ui:description": "Default audio volume (0-100) when cutting to this source",
						"ui:summaryTitle": "Volume"
					},
					"inputLayer": {
						"type": "string",
						"ui:title": "Input Layer",
						"ui:description": "vMix 27+ input layer name, when the source is a layer on a composite input"
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"ui:title": "Tags",
						"ui:description": "Free-form tags for grouping sources in adLib shelves (e.g. studio, spravy, weather)"
					}
				},
				"required": ["input", "type"]
			}
		},
		"vmixAutomationMacros": {
			"type": "object",
			"ui:title": "vMix Automation Macros",
			"ui:description": "Companion-style multi-step automations mapped to Sofie adLib actions",
			"ui:category": "Automations",
			"additionalProperties": {
				"type": "object",
				"title": "VmixAutomationMacro",
				"properties": {
					"label": {
						"type": "string",
						"ui:title": "Label",
						"ui:description": "Display name shown in the Sofie shelf",
						"ui:summaryTitle": "Label"
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"ui:title": "Tags",
						"ui:description": "Shelf grouping tags (e.g. studio-master, spravy, weather)"
					},
					"steps": {
						"type": "array",
						"ui:title": "Steps",
						"items": {
							"$ref": "#/$defs/VmixAutomationStep"
						}
					}
				},
				"required": ["label", "steps"]
			}
		},
		"sisyfosSources": {
			"type": "object",
			"ui:title": "Sisyfos Sources",
			"ui:description": "Description of Sisyfos channels",
			"ui:category": "Audio",
			"additionalProperties": {
				"type": "object",
				"title": "SiyfosSourceConfig",
				"properties": {
					"source": {
						"type": "integer",
						"ui:title": "Source",
						"ui:description": "Channel number of the sisyfos channel",
						"ui:summaryTitle": "Source",
						"default": 1
					},
					"type": {
						"type": "string",
						"ui:title": "Type",
						"ui:description": "Input Type",
						"ui:summaryTitle": "Type",
						"default": "host",

						"title": "AudioSourceType",
						"enum": ["host", "guest", "remote", "playback"],
						"tsEnumNames": ["Host", "Guest", "Remote", "Playback"]
					}
				},
				"required": ["source", "type"]
			}
		},
		"previewRenderer": {
			"type": "string",
			"ui:title": "Preview Renderer",
			"ui:description": "Graphics preview renderer URL",
			"ui:category": "Graphics",
			"default": ""
		},
		"casparcgLatency": {
			"type": "integer",
			"ui:title": "CasparCG Latency",
			"ui:description": "Delay in ms before SDI signal hits the mixer",
			"ui:category": "Playback",
			"min": 0
		}
	},
	"required": [
		"previewRenderer",
		"casparcgLatency",
		"sisyfosSources",
		"vmixSources",
		"vmixAutomationMacros",
		"atemOutputs",
		"atemSources",
		"visionMixer",
		"audioMixer",
		"casparcg"
	],
	"$defs": {
		"SourceType": {
			"title": "SourceType",
			"type": "string",
			"enum": ["camera", "remote", "mediaplayer", "graphics", "multiview"],
			"tsEnumNames": ["Camera", "Remote", "MediaPlayer", "Graphics", "MultiView"],

			"ui:title": "Type",
			"ui:description": "Input Type",
			"ui:summaryTitle": "Type",
			"default": "camera"
		},
		"VmixSourceCategory": {
			"title": "VmixSourceCategory",
			"type": "string",
			"enum": ["video", "technical", "graphics"],
			"tsEnumNames": ["Video", "Technical", "Graphics"],
			"ui:title": "Category",
			"ui:description": "Broad category for shelf grouping (video = live/VT, technical = mix buses/stingers, graphics = titles/overlays)",
			"ui:summaryTitle": "Category",
			"default": "video"
		},
		"VmixAutomationStep": {
			"title": "VmixAutomationStep",
			"type": "object",
			"properties": {
				"action": {
					"type": "string",
					"title": "VmixAutomationAction",
					"enum": [
						"programCut",
						"previewInput",
						"overlayIn",
						"overlayOut",
						"overlayOff",
						"audioVolume",
						"videoPlay",
						"videoPause",
						"videoRestart",
						"wait",
						"tsrAction",
						"httpGet"
					],
					"tsEnumNames": [
						"ProgramCut",
						"PreviewInput",
						"OverlayIn",
						"OverlayOut",
						"OverlayOff",
						"AudioVolume",
						"VideoPlay",
						"VideoPause",
						"VideoRestart",
						"Wait",
						"TsrAction",
						"HttpGet"
					],
					"ui:title": "Action",
					"ui:description": "Companion-equivalent operation type"
				},
				"sourceKey": {
					"type": "string",
					"ui:title": "Source Key",
					"ui:description": "Key from vmixSources to resolve input number (e.g. cam1, stinger_headline)"
				},
				"input": {
					"type": "integer",
					"ui:title": "Input",
					"ui:description": "Explicit vMix input number (overrides sourceKey)"
				},
				"overlayChannel": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4,
					"ui:title": "Overlay Channel",
					"ui:description": "Overlay channel 1-4 (for overlayIn/Out/Off)"
				},
				"volume": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100,
					"ui:title": "Volume",
					"ui:description": "Audio volume 0-100 (for audioVolume)"
				},
				"fadeMs": {
					"type": "integer",
					"minimum": 0,
					"ui:title": "Fade (ms)",
					"ui:description": "Audio fade duration in milliseconds"
				},
				"delayMs": {
					"type": "integer",
					"minimum": 0,
					"ui:title": "Delay (ms)",
					"ui:description": "Wait duration in milliseconds (for wait action)"
				},
				"tsrActionId": {
					"type": "string",
					"ui:title": "TSR Action ID",
					"ui:description": "TSR action name (e.g. browserReload, lastPreset)"
				},
				"tsrActionPayload": {
					"type": "object",
					"ui:title": "TSR Action Payload",
					"ui:description": "JSON payload for the TSR action"
				},
				"url": {
					"type": "string",
					"ui:title": "HTTP URL",
					"ui:description": "URL for httpGet (Companion HTTP module equivalent)"
				}
			},
			"required": ["action"]
		}
	}
}