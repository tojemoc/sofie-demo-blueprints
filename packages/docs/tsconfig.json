{
	// This file is not used in compilation. It is here just for a nice editor experience and ESLint.
	"include": ["src"],
	"compilerOptions": {
		"allowJs": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"paths": {
			"@site/*": ["./*"]
		},
		"skipLibCheck": true,
		// Pull in classic theme ambient `@theme/*` modules (title/description on Layout, etc.).
		// The stub in `@docusaurus/module-type-aliases` alone omits those props.
		"types": ["@docusaurus/theme-classic"]
	}
}
